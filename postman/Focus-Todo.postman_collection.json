{
  "info": {"_postman_id": "ccbe2f61-e719-4f76-8614-focus-todo-api", "name": "Focus Todo REST API", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable": [{"key": "baseUrl", "value": "http://localhost:3000/api"}, {"key": "todoId", "value": ""}],
  "item": [
    {"name": "Health check", "request": {"method": "GET", "url": "{{baseUrl}}/health"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('API is healthy', () => pm.response.to.have.status(200));"]}}]},
    {"name": "Create todo", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"title\": \"Prepare internship demo\",\n  \"description\": \"Walk through the architecture\",\n  \"priority\": \"high\",\n  \"dueDate\": null\n}"}, "url": "{{baseUrl}}/todos"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Created', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('todoId', pm.response.json().data.id);"]}}]},
    {"name": "List todos", "request": {"method": "GET", "url": "{{baseUrl}}/todos"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Returns an array', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data).to.be.an('array'); });"]}}]},
    {"name": "Read todo", "request": {"method": "GET", "url": "{{baseUrl}}/todos/{{todoId}}"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Returns created todo', () => pm.response.to.have.status(200));"]}}]},
    {"name": "Complete todo", "request": {"method": "PATCH", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"completed\": true\n}"}, "url": "{{baseUrl}}/todos/{{todoId}}"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Marked complete', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data.completed).to.be.true; });"]}}]},
    {"name": "Delete todo", "request": {"method": "DELETE", "url": "{{baseUrl}}/todos/{{todoId}}"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Deleted', () => pm.response.to.have.status(204));"]}}]},
    {"name": "Validation example", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{ \"title\": \"\" }"}, "url": "{{baseUrl}}/todos"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Rejects empty title', () => pm.response.to.have.status(422));"]}}]}
  ]
}
